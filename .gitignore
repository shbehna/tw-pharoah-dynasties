# Only the files needed to generate the mod are versioned. Everything below is
# downloaded or generated by the scripts.

# Tools downloaded by scripts/setup.ps1 (RPFM, schema, dependencies cache)
tools/
# Game data extracted by scripts/extract.ps1
reference/
# Mod source and change report written by generator/generate.py
src/
docs/
# Packs built by scripts/build.ps1
dist/

__pycache__/
*.pyc

# Compatibility add-ons written by generator/generate.py
src_addons/

# Separate mods written by generator/generate.py
src_mods/
